{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@mod/*": ["./src/api/module/*"],
      "@api/*": ["./src/api/*"],
      "@core/*": ["./src/core/*"],
      "@/*": ["./src/*"],
      "generated/*": ["./generated/*"],
    }
  },
  "include": ["src", "generated"]
}